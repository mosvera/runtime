{
  "name": "@mosvera/runtime",
  "version": "0.1.0",
  "description": "Reference runtime for Mosvera. Validate and resolve Mosvera JSON, apply merge and compile semantics, and ship the v0.1 schemas for JavaScript and TypeScript apps.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://mosvera.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosvera/runtime.git"
  },
  "bugs": {
    "url": "https://github.com/mosvera/runtime/issues"
  },
  "keywords": [
    "mosvera",
    "aesthetic-infrastructure",
    "ai",
    "runtime",
    "json-schema"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./dist/schemas/*"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "ci": "npm run build && npm run typecheck && npm test",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.7",
    "@types/node": "^22.10.2"
  }
}
